# PostgreSQL
POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=knowledge
POSTGRES_PORT=5432
APP_PORT=8080
FRONTEND_PORT=4200
DATABASE_URL=jdbc:postgresql://localhost:5432/knowledge
DATABASE_USERNAME=knowledge
DATABASE_PASSWORD=knowledge

# Optional local tools (enable with the matching Compose profile)
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.test
PGADMIN_DEFAULT_PASSWORD=change-this-local-password

# JWT: set a base64 value from `openssl rand -base64 32` for stable tokens.
# When unset the app creates an ephemeral key, suitable only for local health checks.
KPF_JWT_SECRET=
KPF_JWT_ISSUER=knowledge-profiling-platform
KPF_DEMO_USER_PASSWORD=
KPF_DEMO_ADMIN_PASSWORD=
# Optional HMAC salt for session/audit pseudonyms; an empty value uses a process-random key.
KPF_PSEUDONYM_SECRET=
FRONTEND_ORIGIN=http://localhost:4200
GITHUB_TOKEN=
KPF_GITHUB_REPOSITORY=owner/repository
GITHUB_API_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=
KPF_GENERATED_DOCS=docs/generated
KPF_REGULATION_PATH=data/regulation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Evaluation (make eval): requires backend, a running LLM and synthetic fixtures.
KPF_EVAL_ADMIN_USERNAME=demo-admin
KPF_EVAL_ADMIN_PASSWORD=
EVAL_JUDGE_MODEL=llama3.2
EVAL_TIMEOUT=120
